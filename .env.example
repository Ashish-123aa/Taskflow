# ─────────────────────────────────────────────────────────────────────────
# TaskFlow — Environment Variables
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored — never commit real secrets.
#
# In Phase 2, these will be validated at startup with a Zod schema
# (see docs/architecture.md → "Why validate environment variables?").
# If a required variable is missing, the app fails fast with a clear
# error instead of crashing confusingly later.
# ─────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml's postgres service.
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow

# ── Redis ────────────────────────────────────────────────────────────────
# Used for BullMQ (job queues), rate limiting, and caching.
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g.: `openssl rand -base64 48`
# Must be at least 32 characters (enforced at startup) and never reused
# across environments.
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
# How long a login session lasts. There's no refresh-token flow yet — the
# JWT itself is the session — so this is intentionally session-length
# (days), not the short 15m an access token would use alongside a refresh
# token. See docs/security.md for the trade-off.
JWT_EXPIRES_IN=7d

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ── Email (local dev uses MailHog — see docker-compose.yml, added when
#    the email job handler is implemented) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taskflow.local

# ── File uploads (CSV job) ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ── External API job / SSRF protection ──────────────────────────────────
EXTERNAL_REQUEST_TIMEOUT_MS=10000
EXTERNAL_MAX_RESPONSE_SIZE_MB=5
