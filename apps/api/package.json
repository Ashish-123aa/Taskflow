{
  "name": "@taskflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow REST API — accepts requests, writes to Postgres, enqueues jobs to Redis. Never executes job logic itself.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskflow/shared": "*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.12",
    "socket.io": "^4.7.5",
    "multer": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "cookie-parser": "^1.4.6",
    "cookie": "^0.6.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/node": "^20.14.15",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/cookie-parser": "^1.4.7",
    "@types/cookie": "^0.6.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/node-cron": "^3.0.11"
  }
}
