{
  "name": "@taskflow/worker",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow Worker — a separate Node.js process that pulls jobs off Redis/BullMQ and executes them. Never handles HTTP requests.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskflow/shared": "*",
    "bullmq": "^5.12.12",
    "dotenv": "^16.4.5",
    "csv-parse": "^5.5.6",
    "nodemailer": "^6.9.14",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15"
  }
}
