{
  "name": "@taskflow/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client, shared TypeScript types, Zod schemas, and constants used by both the API and the Worker.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "studio": "prisma studio --schema=prisma/schema.prisma",
    "seed": "prisma db seed --schema=prisma/schema.prisma",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "zod": "^3.23.8",
    "bcrypt": "^5.1.1",
    "winston": "^3.13.1",
    "ioredis": "^5.4.1",
    "cron-parser": "^5.0.6"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "@types/bcrypt": "^5.0.2"
  }
}
